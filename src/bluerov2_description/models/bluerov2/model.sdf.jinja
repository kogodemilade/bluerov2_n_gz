<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <model name="{{robot.name}}">
    <pose>{{robot.x}} {{robot.y}} {{robot.z}} 0 0 0</pose>

    <!-- BlueROV2/Orca5 thruster reference -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0.011 0 0 0</pose>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.099</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.178</iyy>
          <iyz>0</iyz>
          <izz>0.269</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <geometry>
          <mesh>
            <uri>model://bluerov2/meshes/bluerov2.dae</uri>
            <scale>0.025 0.025 0.025</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="base_link_collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.457 0.338 0.065</size>
          </box>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 3.142 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000.0</update_rate>
      </sensor>
    </link>

    <plugin
        filename="gz-sim-hydrodynamics-system"
        name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>998.0</water_density>
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <zDotW>0</zDotW>
      <kDotP>0</kDotP>
      <mDotQ>0</mDotQ>
      <nDotR>0</nDotR>
      <xU>0</xU>
      <yV>0</yV>
      <zW>0</zW>
      <kP>0</kP>
      <mQ>0</mQ>
      <nR>0</nR>
      <xUabsU>-33.732</xUabsU>
      <yVabsV>-54.16</yVabsV>
      <zWabsW>-73.225</zWabsW>
      <kPabsP>-3.992</kPabsP>
      <mQabsQ>-3.992</mQabsQ>
      <nRabsR>-3.992</nRabsR>
    </plugin>

    <!-- Thrusters -->
    <link name="thruster1">
      <pose>0.14 -0.092 0.0 -1.571 1.571 -0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <link name="thruster2">
      <pose>0.14 0.092 0.0 -1.571 1.571 -2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 0</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <link name="thruster3">
      <pose>-0.14 -0.092 0.0 -1.571 1.571 0.785</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_cw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <link name="thruster4">
      <pose>-0.14 0.092 0.0 -1.571 1.571 2.356</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 0</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_cw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <link name="thruster5">
      <pose>0 -0.109 0.077 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 -1.571 0 1.571</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_ccw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <link name="thruster6">
      <pose>0 0.109 0.077 0 0 0</pose>
      <visual name="thruster_prop_visual">
        <pose>0 0 0 1.571 0 1.571</pose>
        <geometry>
          <mesh><uri>model://bluerov2/meshes/t200_cw_prop.dae</uri></mesh>
        </geometry>
      </visual>
      <inertial><mass>0.002</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <joint name="thruster1_joint" type="revolute"><parent>base_link</parent><child>thruster1</child><axis><xyz>0 0 -1</xyz></axis></joint>
    <joint name="thruster2_joint" type="revolute"><parent>base_link</parent><child>thruster2</child><axis><xyz>0 0 -1</xyz></axis></joint>
    <joint name="thruster3_joint" type="revolute"><parent>base_link</parent><child>thruster3</child><axis><xyz>0 0 -1</xyz></axis></joint>
    <joint name="thruster4_joint" type="revolute"><parent>base_link</parent><child>thruster4</child><axis><xyz>0 0 -1</xyz></axis></joint>
    <joint name="thruster5_joint" type="revolute"><parent>base_link</parent><child>thruster5</child><axis><xyz>0 0 -1</xyz></axis></joint>
    <joint name="thruster6_joint" type="revolute"><parent>base_link</parent><child>thruster6</child><axis><xyz>0 0 -1</xyz></axis></joint>

    <!-- Thruster plugins -->
    {% for i in range(1, 7) %}
    <plugin filename="gz-sim-thruster-system"
            name="gz::sim::systems::Thruster">
      <namespace>{{robot.namespace}}</namespace>
      <joint_name>thruster{{i}}_joint</joint_name>
      <thrust_coefficient>{% if i in [3, 4, 6] %}-0.02{% else %}0.02{% endif %}</thrust_coefficient>
      <fluid_density>998.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>
    {% endfor %}

    <!-- ArduPilot -->
    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>{{robot.fdm_port}}</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <modelXYZToAirplaneXForwardZDown>0 0 0 3.142 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.142 0 1.571</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      {% for i in range(1, 7) %}
      <control channel="{{i - 1}}">
        <jointName>thruster{{i}}_joint</jointName>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/model/{{robot.name}}/joint/thruster{{i}}_joint/cmd_thrust</cmd_topic>
        <offset>-0.5</offset>
        <multiplier>100</multiplier>
      </control>
      {% endfor %}

      <sensor>
        <type>sonar</type>
        <index>1</index>
        <topic>ping_link/sensor/sonar</topic>
      </sensor>
    </plugin>

    <!-- Camera -->
    <link name="camera_link">
      <pose>-0.18 0.18 0.0575 0 1.571 0</pose>
      <visual name="camera_tube">
        <geometry><cylinder><length>0.135</length><radius>0.0275</radius></cylinder></geometry>
      </visual>
      <sensor name="sim_camera" type="camera">
        <pose>0 0 -0.0875 0 0 0</pose>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>800</width><height>600</height></image>
          <clip><near>0.2</near><far>4</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>{{robot.name}}/image_raw</topic>
        <gz_frame_id>camera_sensor</gz_frame_id>
      </sensor>
      <inertial><mass>0.001</mass><inertia>
        <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
      </inertia></inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Ping sonar (rangefinder) link -->
    <link name='ping_link'>
      <pose>-0.15 0 -0.095 0 0 0</pose>
      <inertial>
        <mass>0.133</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>

      <visual name="ping_visual">
        <geometry>
          <cylinder>
            <length>0.035</length>
            <radius>0.024</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.2 0.0 1.0</ambient>
          <diffuse>0.0 0.2 0.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Use a gpu_lidar sensor to emulate a Ping sonar sensor. The sensor is configured to generate 5x5=25 range
           values in a pretty tight square. (The beam angle is 17 degrees in x or y, or 24 degrees diagonally.)
           ardupilot_gazebo will pick the minimum value and send it as a rangefinder reading. -->
      <sensor name='ping_sonar' type='gpu_lidar'>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>1</visualize>
        <topic>ping_link/sensor/sonar</topic>
        <pose>0 0 0 0 1.57079 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.14835</min_angle>
              <max_angle>0.14835</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>50</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.1</mean>
            <stddev>0.005</stddev>
          </noise>
        </ray>
      </sensor>
    </link>

    <joint name='ping_joint' type='revolute'>
      <parent>base_link</parent>
      <child>ping_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Ground-truth odometry -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>{{robot.name}}</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>